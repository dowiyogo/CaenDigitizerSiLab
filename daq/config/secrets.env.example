# Ejemplo de ~/.config/daqv2/secrets.env. Lo crea René (modo 600, directorio 700), nunca dentro
# del repositorio. Líneas KEY=VALUE, comentarios con '#', sin comillas ni expansión de shell:
# el valor es el texto exacto después del primer '='.
DAQ_HV_HOST=192.168.1.118
DAQ_HV_USER=usuario
DAQ_HV_PASSWORD=cambiar
DAQ_SMTP_URL=smtps://smtp.example.org:465
DAQ_SMTP_USER=usuario@example.org
DAQ_SMTP_PASSWORD=cambiar
DAQ_NOTIFY_FROM=daq@example.org
DAQ_NOTIFY_TO=persona@example.org
