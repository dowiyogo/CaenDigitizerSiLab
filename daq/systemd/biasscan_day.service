# biasscan_day.service — DAQ2-15: barrido de tensión de día (arranque a mano; corte = arranque + 6 h)
# ExecStopPost: pase lo que pase, nominal restaurado (noop si la sesión ya se cerró) y run de física activo.
[Unit]
Description=DAQ2-15 barrido de tensión de día (arranque a mano; corte = arranque + 6 h)
After=hvmon.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 -I /home/xplus/digitizer/CaenDigitizerSiLab-jai/daq/tools/biasscan/biasscan.py --campaign biasscan_2026_10_23_day --max-hours 6
ExecStopPost=/home/xplus/digitizer/CaenDigitizerSiLab-jai/daq/tools/biasscan/biasscan_safety.sh
KillSignal=SIGTERM
TimeoutStopSec=900
RuntimeMaxSec=25200
Restart=no
